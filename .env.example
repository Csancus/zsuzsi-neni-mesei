# --- Feliratkozás ---
# Web3Forms – ingyenes űrlap-továbbító. A kulcsot a web3forms.com oldalon kell kikérni
# arra az e-mail címre, ahova az értesítéseket várod (csanad.peter.czarth@gmail.com),
# a kulcs pillanatokon belül megérkezik levélben.
# Amíg ez nincs kitöltve, a /api/signup 503-mal válaszol, és az űrlap őszintén jelzi,
# hogy a regisztráció még nem él.
WEB3FORMS_ACCESS_KEY=

# --- /szamok kattintásmérés ---
# Jelszó a /szamok oldalhoz. Bármilyen hosszú, véletlen sztring lehet.
SZAMOK_PW=

# A Vercel Blob tároló írási tokenje. Vercelen a Storage fülön létrehozott Blob
# store csatolásakor automatikusan bekerül a projekt környezeti változói közé,
# lokálisan a `vercel env pull` hozza le.
BLOB_READ_WRITE_TOKEN=
